> Module StraddleAbuseTaxModel

```catala
declaration structure RecognizedStraddleHistory:
  data gain_leg_realized content boolean
  data loss_leg_realized content boolean

declaration structure TaxpayerCtfAllocation:
  data ordinary_income content money
  data allocated_gain content money
  data allocated_loss content money
  data unrecognized_gain content money
  data tax_rate content decimal

declaration structure CommonTrustFundTaxInput:
  data straddle_history content RecognizedStraddleHistory
  data taxpayer_allocation content TaxpayerCtfAllocation

declaration scope TaxpayerStraddleTaxComputation:
  input ctf_tax_input content CommonTrustFundTaxInput

  internal realized_gain content money
  internal realized_loss content money
  internal deductible_loss content money
  internal baseline_taxable_income content money
  internal current_taxable_income content money
  internal baseline_tax_due content money
  internal current_tax_due content money

  output tax_reduction content money
```

```catala
scope TaxpayerStraddleTaxComputation:
  definition realized_gain equals
    if ctf_tax_input.straddle_history.gain_leg_realized then
      ctf_tax_input.taxpayer_allocation.allocated_gain
    else
      $0

  definition realized_loss equals
    if ctf_tax_input.straddle_history.loss_leg_realized then
      ctf_tax_input.taxpayer_allocation.allocated_loss
    else
      $0

  definition deductible_loss equals
    if realized_loss <= ctf_tax_input.taxpayer_allocation.unrecognized_gain then
      $0
    else
      realized_loss - ctf_tax_input.taxpayer_allocation.unrecognized_gain

  definition baseline_taxable_income equals
    ctf_tax_input.taxpayer_allocation.ordinary_income

  definition current_taxable_income equals
    ctf_tax_input.taxpayer_allocation.ordinary_income
    + realized_gain
    - deductible_loss

  definition baseline_tax_due equals
    if baseline_taxable_income <= $0 then
      $0
    else
      baseline_taxable_income * ctf_tax_input.taxpayer_allocation.tax_rate

  definition current_tax_due equals
    if current_taxable_income <= $0 then
      $0
    else
      current_taxable_income * ctf_tax_input.taxpayer_allocation.tax_rate

  definition tax_reduction equals
    baseline_tax_due - current_tax_due
```

```catala
declaration scope TestNoRealizedGain:
  output computation content TaxpayerStraddleTaxComputation

scope TestNoRealizedGain:
  definition computation equals
    output of TaxpayerStraddleTaxComputation with {
      -- ctf_tax_input:
        CommonTrustFundTaxInput {
          -- straddle_history:
            RecognizedStraddleHistory {
              -- gain_leg_realized: false
              -- loss_leg_realized: false
            }
          -- taxpayer_allocation:
            TaxpayerCtfAllocation {
              -- ordinary_income: $100
              -- allocated_gain: $100
              -- allocated_loss: $0
              -- unrecognized_gain: $0
              -- tax_rate: 37%
            }
        }
    }

declaration scope TestGainOnly:
  output computation content TaxpayerStraddleTaxComputation

scope TestGainOnly:
  definition computation equals
    output of TaxpayerStraddleTaxComputation with {
      -- ctf_tax_input:
        CommonTrustFundTaxInput {
          -- straddle_history:
            RecognizedStraddleHistory {
              -- gain_leg_realized: true
              -- loss_leg_realized: false
            }
          -- taxpayer_allocation:
            TaxpayerCtfAllocation {
              -- ordinary_income: $100
              -- allocated_gain: $100
              -- allocated_loss: $0
              -- unrecognized_gain: $0
              -- tax_rate: 37%
            }
        }
    }

declaration scope TestGainAndLossOffset:
  output computation content TaxpayerStraddleTaxComputation

scope TestGainAndLossOffset:
  definition computation equals
    output of TaxpayerStraddleTaxComputation with {
      -- ctf_tax_input:
        CommonTrustFundTaxInput {
          -- straddle_history:
            RecognizedStraddleHistory {
              -- gain_leg_realized: true
              -- loss_leg_realized: true
            }
          -- taxpayer_allocation:
            TaxpayerCtfAllocation {
              -- ordinary_income: $100
              -- allocated_gain: $100
              -- allocated_loss: $60
              -- unrecognized_gain: $0
              -- tax_rate: 37%
            }
        }
    }
```
