> Module TaxModel

```catala
declaration structure Entity:
  data incorporation_jurisdiction content Jurisdiction
  data tax_residence content Jurisdiction

declaration structure Payment:
  data payer content Entity
  data receiver content Entity
  data amount content money

declaration enumeration Jurisdiction:
  -- Ireland
  -- Bermuda
  -- Netherlands
  -- US
  -- Germany

declaration structure EntityTaxInput:
  data entity content Entity
  data gross_revenue content money
  data outgoing_payments content list of Payment

declaration scope RoyaltyDeductibility:
  input payment content Payment
  internal payer_country content Jurisdiction
  internal receiver_country content Jurisdiction
  internal eu_royalty_deductible content boolean
  internal us_royalty_deductible content boolean
  output deductible_amount content money

declaration scope CorporateTaxComputation:
  input entity content Entity
  input gross_revenue content money
  input outgoing_payments content list of Payment
  internal deductible_payments content money
  internal tax_base content money
  internal tax_rate content decimal
  output tax_due content money

declaration scope WithholdingTaxComputation:
  input payment content Payment
  internal withholding_rate content decimal
  output withholding_tax_due content money

declaration scope EntityTaxOutcome:
  input entity content Entity
  input gross_revenue content money
  input outgoing_payments content list of Payment

  corporate_tax_computation scope CorporateTaxComputation
  internal withholding_tax content money

  output total_tax content money

declaration scope GroupTaxOutcome:
  input entity_inputs content list of EntityTaxInput
  output total_group_tax content money
```

```catala
scope RoyaltyDeductibility:
  definition payer_country equals
    payment.payer.tax_residence

  definition receiver_country equals
    payment.receiver.tax_residence

scope RoyaltyDeductibility:
  definition eu_royalty_deductible equals
    (payer_country = Ireland and receiver_country = Netherlands)
    or (payer_country = Netherlands and receiver_country = Ireland)
    or (payer_country = Ireland and receiver_country = Germany)
    or (payer_country = Germany and receiver_country = Ireland)
    or (payer_country = Netherlands and receiver_country = Germany)
    or (payer_country = Germany and receiver_country = Netherlands)

scope RoyaltyDeductibility:
  definition us_royalty_deductible equals
    payer_country = US

scope RoyaltyDeductibility:
  definition deductible_amount equals
    if eu_royalty_deductible then
      payment.amount
    else if us_royalty_deductible then
      payment.amount
    else
      $0
```

```catala
scope CorporateTaxComputation:
  definition deductible_payments equals
    Money.sum of
      map each payment among outgoing_payments to
        (output of RoyaltyDeductibility with {
          -- payment: payment
        }).deductible_amount

scope CorporateTaxComputation:
  definition tax_base equals
    if gross_revenue - deductible_payments <= $0 then
      $0
    else
      gross_revenue - deductible_payments

scope CorporateTaxComputation:
  definition tax_rate equals
    match entity.tax_residence with pattern
      -- Ireland: 12.5%
      -- Netherlands: 25.8%
      -- Bermuda: 0%
      -- US: 21%
      -- Germany: 15%

scope CorporateTaxComputation:
  definition tax_due equals
    tax_base * tax_rate
```

```catala

scope WithholdingTaxComputation:
  definition withholding_rate equals
    match payment.payer.tax_residence with pattern
    -- Ireland:
      if payment.receiver.tax_residence = Netherlands then
        0%
      else if payment.receiver.tax_residence = Germany then
        0%
      else if payment.receiver.tax_residence = Bermuda then
        20%
      else
        10%

    -- Netherlands:
      if payment.receiver.tax_residence = Ireland then
        0%
      else if payment.receiver.tax_residence = Germany then
        0%
      else if payment.receiver.tax_residence = Bermuda then
        0%
      else
        5%

    -- Bermuda:
      0%

    -- US:
      if payment.receiver.tax_residence = Ireland then
        0%
      else if payment.receiver.tax_residence = Netherlands then
        0%
      else if payment.receiver.tax_residence = Germany then
        0%
      else
        10%

    -- Germany:
      if payment.receiver.tax_residence = Ireland then
        0%
      else if payment.receiver.tax_residence = Netherlands then
        0%
      else
        15%

scope WithholdingTaxComputation:
  definition withholding_tax_due equals
    payment.amount * withholding_rate
```
```catala
scope EntityTaxOutcome:
  definition corporate_tax_computation.entity equals
    entity

  definition corporate_tax_computation.gross_revenue equals
    gross_revenue

  definition corporate_tax_computation.outgoing_payments equals
    outgoing_payments

scope EntityTaxOutcome:
  definition withholding_tax equals
    Money.sum of
      map each payment among outgoing_payments to
        (output of WithholdingTaxComputation with {
          -- payment: payment
        }).withholding_tax_due

scope EntityTaxOutcome:
  definition total_tax equals
    corporate_tax_computation.tax_due + withholding_tax
```

```catala
scope GroupTaxOutcome:
  definition total_group_tax equals
    Money.sum of
      map each entity_input among entity_inputs to
        (output of EntityTaxOutcome with {
          -- entity: entity_input.entity
          -- gross_revenue: entity_input.gross_revenue
          -- outgoing_payments: entity_input.outgoing_payments
        }).total_tax
```

```catala
declaration scope TestRoyaltyDeductibility:
  output computation content RoyaltyDeductibility

scope TestRoyaltyDeductibility:
  definition computation equals
    output of RoyaltyDeductibility with {
      -- payment:
        Payment {
          -- payer:
            Entity {
              -- incorporation_jurisdiction: Ireland
              -- tax_residence: Ireland
            }
          -- receiver:
            Entity {
              -- incorporation_jurisdiction: Netherlands
              -- tax_residence: Netherlands
            }
          -- amount: $90
        }
    }
```

```catala
declaration scope TestCorporateTaxComputation:
  output computation content CorporateTaxComputation

scope TestCorporateTaxComputation:
  definition computation equals
    output of CorporateTaxComputation with {
      -- entity:
        Entity {
          -- incorporation_jurisdiction: Ireland
          -- tax_residence: Ireland
        }
      -- gross_revenue: $100
      -- outgoing_payments:
        [
          Payment {
            -- payer:
              Entity {
                -- incorporation_jurisdiction: Ireland
                -- tax_residence: Ireland
              }
            -- receiver:
              Entity {
                -- incorporation_jurisdiction: Netherlands
                -- tax_residence: Netherlands
              }
            -- amount: $90
          }
        ]
    }
```

```catala
declaration scope TestWithholding:
  output computation content WithholdingTaxComputation

scope TestWithholding:
  definition computation equals
    output of WithholdingTaxComputation with {
      -- payment:
        Payment {
          -- payer:
            Entity {
              -- incorporation_jurisdiction: Ireland
              -- tax_residence: Ireland
            }
          -- receiver:
            Entity {
              -- incorporation_jurisdiction: Netherlands
              -- tax_residence: Netherlands
            }
          -- amount: $90
        }
    }
```

```catala
declaration scope TestEntityTaxOutcome:
  output computation content EntityTaxOutcome

scope TestEntityTaxOutcome:
  definition computation equals
    output of EntityTaxOutcome with {
      -- entity:
        Entity {
          -- incorporation_jurisdiction: Ireland
          -- tax_residence: Ireland
        }
      -- gross_revenue: $100
      -- outgoing_payments:
        [
          Payment {
            -- payer:
              Entity {
                -- incorporation_jurisdiction: Ireland
                -- tax_residence: Ireland
              }
            -- receiver:
              Entity {
                -- incorporation_jurisdiction: Netherlands
                -- tax_residence: Netherlands
              }
            -- amount: $90
          }
        ]
    }
```